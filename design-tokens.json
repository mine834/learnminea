{
  "meta": {
    "siteName": "learnminea",
    "visualDirection": "playful-green-learning",
    "motionLevel": 2,
    "defaultLocale": "mn",
    "locales": ["mn", "en", "ko"]
  },
  "colors": {
    "brand": {
      "surfBlue": "#58cc02",
      "deepCurrent": "#46a302",
      "skyStart": "#1cb0f6",
      "skyMid": "#1cb0f6",
      "skyEnd": "#d7ffb8",
      "blushPeach": "#d7ffb8",
      "siennaBrown": "#042c60"
    },
    "neutral": {
      "ink": "#3c3c3c",
      "paper": "#ffffff",
      "mist": "#ffffff",
      "fog": "#ffffff",
      "hairline": "#e5e5e5",
      "slate": "#777777",
      "smoke": "#b4b4b4"
    },
    "semantic": {
      "background": "#ffffff",
      "foreground": "#3c3c3c",
      "card": "#ffffff",
      "cardForeground": "#3c3c3c",
      "popover": "#ffffff",
      "popoverForeground": "#3c3c3c",
      "primary": "#58cc02",
      "primaryForeground": "#ffffff",
      "secondary": "#d7ffb8",
      "secondaryForeground": "#042c60",
      "muted": "#f2f2f3",
      "mutedForeground": "#777777",
      "accent": "#d7ffb8",
      "accentForeground": "#042c60",
      "border": "#e5e5e5",
      "input": "#ffffff",
      "ring": "#58cc02",
      "success": "#58cc02",
      "warning": "#a86700",
      "destructive": "#b33939"
    }
  },
  "typography": {
    "families": {
      "display": "Nunito",
      "body": "Nunito",
      "mono": "Geist Mono"
    },
    "scale": {
      "caption": { "size": "12px", "lineHeight": "1.4" },
      "bodySm": { "size": "14px", "lineHeight": "1.5" },
      "body": { "size": "16px", "lineHeight": "1.55" },
      "subheading": { "size": "18px", "lineHeight": "1.45" },
      "headingSm": { "size": "26px", "lineHeight": "1.2" },
      "heading": { "size": "44px", "lineHeight": "1.2" },
      "headingLg": { "size": "60px", "lineHeight": "1.05" },
      "display": { "size": "72px", "lineHeight": "1" }
    }
  },
  "spacing": {
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    },
    "layout": {
      "maxWidth": "1200px",
      "sectionGap": "80px",
      "pageGutterDesktop": "40px",
      "pageGutterMobile": "20px"
    }
  },
  "radius": {
    "sm": "12px",
    "md": "12px",
    "lg": "12px",
    "xl": "12px",
    "search": "12px",
    "pill": "12px"
  },
  "shadows": {
    "sm": "none",
    "md": "none",
    "lg": "none",
    "button": "none"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "160ms",
      "normal": "400ms",
      "slow": "650ms",
      "page": "300ms",
      "stagger": "80ms"
    },
    "easing": {
      "default": [0.22, 1, 0.36, 1],
      "decelerate": [0.16, 1, 0.3, 1],
      "accelerate": [0.4, 0, 1, 1]
    },
    "spring_configs": {
      "snappy": { "type": "spring", "stiffness": 420, "damping": 34 },
      "gentle": { "type": "spring", "stiffness": 180, "damping": 24 },
      "bouncy": { "type": "spring", "stiffness": 300, "damping": 18 },
      "heavy": { "type": "spring", "stiffness": 140, "damping": 30 },
      "magnetic": { "type": "spring", "stiffness": 260, "damping": 20 }
    },
    "variants": {
      "fadeUp": { "hidden": { "opacity": 0, "y": 40 }, "visible": { "opacity": 1, "y": 0 } },
      "fadeIn": { "hidden": { "opacity": 0 }, "visible": { "opacity": 1 } },
      "fadeDown": { "hidden": { "opacity": 0, "y": -18 }, "visible": { "opacity": 1, "y": 0 } },
      "slideRight": { "hidden": { "opacity": 0, "x": -32 }, "visible": { "opacity": 1, "x": 0 } },
      "slideLeft": { "hidden": { "opacity": 0, "x": 32 }, "visible": { "opacity": 1, "x": 0 } },
      "scaleIn": { "hidden": { "opacity": 0, "scale": 0.97 }, "visible": { "opacity": 1, "scale": 1 } },
      "textReveal": { "hidden": { "opacity": 0, "y": 18 }, "visible": { "opacity": 1, "y": 0 } },
      "liquid": { "hidden": { "opacity": 0 }, "visible": { "opacity": 1 } },
      "shimmer": { "hidden": { "opacity": 0.6 }, "visible": { "opacity": 1 } }
    },
    "gsap_configs": {}
  }
}
